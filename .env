DB_USER = "neondb_owner"
DB_PASSWORD = "npg_Uk8MNntDxZ3X"
DB_HOST = "ep-falling-dawn-ab98zpqu-pooler.eu-west-2.aws.neon.tech"
DB_PORT = 5432
DB_SSLMODE = "require"  # Neon requires SSL
#
# How to extract from Neon's DATABASE_URL (postgresql://user:pass@host/dbname?sslmode=require):
# - DB_USER: text between :// and first :
# - DB_PASSWORD: text between first : and @
# - DB_HOST: text between @ and / or :5432
# - DB_PORT: if not in URL, use 5432 (or check Neon dashboard; pooler endpoint uses 5432)
# - DB_NAME: text after last /
# - DB_SSLMODE: extract from ?sslmode query param (e.g., "require")
#
# Notes:
# - `production.py` currently reads DB_* env vars and applies DB_SSLMODE if set.
# - Keep `SECURE_SSL_REDIRECT=True` in production and ensure your deployment terminates TLS (load balancer/reverse proxy).
# - When deploying, set these env vars in your production platform (e.g., Railway, Render, GitHub Secrets, etc.).
